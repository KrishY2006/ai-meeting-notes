PORT=4000
NODE_ENV=development

# Public origin of the deployed front end. Comma-separate to allow several.
# Leave empty in local development to permit any origin.
CORS_ORIGIN=

# Public URL of this application, used as the OpenRouter HTTP-Referer header.
APP_URL=http://localhost:5173
APP_NAME=AI Meeting Notes

MONGODB_URI=your_mongodb_connection_string
JWT_SECRET=your_jwt_secret

OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_URL=https://openrouter.ai/api/v1/chat/completions
CHAT_MODEL=openai/gpt-4o-mini

MAX_TRANSCRIPT_CHARS=40000
DAILY_GENERATION_LIMIT=20
GENERATE_RATE_LIMIT_MAX=5
